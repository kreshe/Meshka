monitor_capture_file() {
    local PORT="$1"
    local LABEL LOGFILE BUFFER="" CH trigger lower
    local last_trigger_time=0
    local last_flash_retry_time=0
    local last_post_login_retry_time=0
    local post_login_retry_count=0
    local flash_retry_count=0
    local now

    # ВАЖНО: эти переменные принадлежат только конкретному UART-процессу.
    # ttyUSB0 и ttyUSB1 никогда не используют общий state/counter.
    local UART_STATE="IDLE"

    LABEL=$(basename "$PORT")
    LOGFILE="$AUTO_LOGIN_LOG_DIR/${LABEL}.log"

    mkdir -p "$AUTO_LOGIN_LOG_DIR"
    touch "$LOGFILE"

    uart_state_transition "$LABEL" "$UART_STATE" "monitor started"

    while IFS= read -r -N 1 CH; do
        BUFFER+="$CH"

        if ((${#BUFFER} > 256)); then
            BUFFER="${BUFFER: -256}"
        fi

        lower="${BUFFER,,}"

        # --------------------------------------------------------------
        # POST-LOGIN RETRY
        # zsh: corrupt history file
        # Повторяем именно PASSWORD -> MODE, без повторной отправки LOGIN.
        # --------------------------------------------------------------
        if [[ "$POST_LOGIN_RETRY_ENABLED" == "1" ]]; then
            local post_login_trigger="${POST_LOGIN_RETRY_TRIGGER,,}"

            if [[ -n "$post_login_trigger" && "$lower" == *"$post_login_trigger"* ]]; then
                now=$(date +%s)

                if (( now - last_post_login_retry_time >= POST_LOGIN_RETRY_COOLDOWN )); then
                    if (( post_login_retry_count < POST_LOGIN_RETRY_MAX )); then
                        post_login_retry_count=$((post_login_retry_count + 1))
                        if [[ "$STATE_MACHINE_ENABLED" == "1" ]]; then
                            uart_state_transition "$LABEL" "WAITING_SHELL" "history corruption detected"
                            uart_state_post_login_retry "$PORT" "$LABEL" "$post_login_retry_count" || true
                        else
                            retry_post_login_sequence "$PORT" || true
                        fi
                    else
                        UART_STATE="ERROR"
                        uart_state_transition "$LABEL" "ERROR" "POST_LOGIN_RETRY_MAX reached"
                    fi
                    last_post_login_retry_time=$now
                fi

                BUFFER=""
                continue
            fi
        fi

        # --------------------------------------------------------------
        # FLASH RETRY
        # --------------------------------------------------------------
        if [[ "$MODE" == "flash" && "$FLASH_RETRY_ENABLED" == "1" ]]; then
            local retry_trigger="${FLASH_RETRY_TRIGGER,,}"

            if [[ -n "$retry_trigger" && "$lower" == *"$retry_trigger"* ]]; then
                now=$(date +%s)

                if (( now - last_flash_retry_time >= FLASH_RETRY_COOLDOWN )); then
                    if (( flash_retry_count < FLASH_RETRY_MAX )); then
                        flash_retry_count=$((flash_retry_count + 1))
                        if [[ "$STATE_MACHINE_ENABLED" == "1" ]]; then
                            uart_state_flash_retry "$PORT" "$LABEL" "$flash_retry_count" || true
                        else
                            send_uart "$PORT" "$INST" || true
                        fi
                    else
                        UART_STATE="ERROR"
                        uart_state_transition "$LABEL" "ERROR" "FLASH_RETRY_MAX reached"
                    fi
                    last_flash_retry_time=$now
                fi

                BUFFER=""
                continue
            fi
        fi

        # --------------------------------------------------------------
        # AUTO LOGIN TRIGGERS
        # --------------------------------------------------------------
        for trigger in "${AUTO_LOGIN_TRIGGERS[@]}"; do
            trigger="${trigger,,}"
            [[ -z "$trigger" ]] && continue

            if [[ "$lower" == *"$trigger"* ]]; then
                now=$(date +%s)

                if (( now - last_trigger_time >= AUTO_LOGIN_COOLDOWN )); then
                    if [[ "$STATE_MACHINE_ENABLED" == "1" ]]; then
                        UART_STATE="LOGIN_TRIGGERED"
                        uart_state_login_sequence "$PORT" "$LABEL" || true
                        UART_STATE="DONE"
                    else
                        auto_login_port "$PORT" || true
                    fi
                    last_trigger_time=$now
                    post_login_retry_count=0
                    flash_retry_count=0
                fi

                BUFFER=""
                break
            fi
        done
    done < <(tail -Fn 0 "$LOGFILE" 2>/dev/null || true)
}


start_uart_monitors() {
    [[ "$AUTO_LOGIN_ENABLED" == "1" ]] || return 0

    stop_uart_monitors
    mkdir -p "$AUTO_LOGIN_LOG_DIR"

    local PORT LABEL LOGFILE
    for PORT in "${PORTS[@]}"; do
        [[ -e "$PORT" ]] || continue

        LABEL=$(basename "$PORT")
        LOGFILE="$AUTO_LOGIN_LOG_DIR/${LABEL}.log"
        touch "$LOGFILE"

        monitor_capture_file "$PORT" &
        MONITOR_PIDS+=("$!")
    done
}

stop_uart_monitors() {
    local pid

    if ((${#MONITOR_PIDS[@]} == 0)); then
        return 0
    fi

    for pid in "${MONITOR_PIDS[@]}"; do
        kill "$pid" 2>/dev/null || true
    done

    MONITOR_PIDS=()
}

