declare -A WINDOW_WIDTH=()
declare -A WINDOW_HEIGHT=()

load_config() {
    [[ -f "$CFG_FILE" ]] || return 0

    local key value a b c d label

    while IFS='=' read -r key value; do
        key="${key##+([[:space:]])}"
        key="${key%%+([[:space:]])}"
        value="${value#${value%%[![:space:]]*}}"
        value="${value%${value##*[![:space:]]}}"

        [[ -z "$key" ]] && continue
        [[ "$key" == \#* ]] && continue

        case "$key" in
            MODE)
                case "$value" in
                    flash|check|check_SD|RFM|CPU) MODE="$value" ;;
                esac
                ;;
            STYLE)
                case "$value" in
                    retro|icons|cyber|table) ME_STYLE="$value" ;;
                esac
                ;;
            AUTO_LOGIN_ENABLED)
                [[ "$value" == 0 || "$value" == 1 ]] && AUTO_LOGIN_ENABLED="$value"
                ;;
            AUTO_LOGIN_COOLDOWN)
                [[ "$value" =~ ^[0-9]+$ ]] && AUTO_LOGIN_COOLDOWN="$value"
                ;;
            FLASH_RETRY_ENABLED)
                [[ "$value" == 0 || "$value" == 1 ]] && FLASH_RETRY_ENABLED="$value"
                ;;
            FLASH_RETRY_COOLDOWN)
                [[ "$value" =~ ^[0-9]+$ ]] && FLASH_RETRY_COOLDOWN="$value"
                ;;
            FLASH_RETRY_TRIGGER)
                [[ -n "$value" ]] && FLASH_RETRY_TRIGGER="$value"
                ;;
            POST_LOGIN_RETRY_ENABLED)
                [[ "$value" == 0 || "$value" == 1 ]] && POST_LOGIN_RETRY_ENABLED="$value"
                ;;
            POST_LOGIN_RETRY_COOLDOWN)
                [[ "$value" =~ ^[0-9]+$ ]] && POST_LOGIN_RETRY_COOLDOWN="$value"
                ;;
            POST_LOGIN_RETRY_TRIGGER)
                [[ -n "$value" ]] && POST_LOGIN_RETRY_TRIGGER="$value"
                ;;
            POST_LOGIN_RETRY_MAX)
                [[ "$value" =~ ^[0-9]+$ ]] && POST_LOGIN_RETRY_MAX="$value"
                ;;
            FLASH_RETRY_MAX)
                [[ "$value" =~ ^[0-9]+$ ]] && FLASH_RETRY_MAX="$value"
                ;;
            STATE_MACHINE_ENABLED)
                [[ "$value" == 0 || "$value" == 1 ]] && STATE_MACHINE_ENABLED="$value"
                ;;
            STATE_MACHINE_VERBOSE)
                [[ "$value" == 0 || "$value" == 1 ]] && STATE_MACHINE_VERBOSE="$value"
                ;;
            AUTO_LOGIN_LOG_DIR)
                [[ -n "$value" ]] && AUTO_LOGIN_LOG_DIR="$value"
                ;;
            AUTO_LOGIN_VERBOSE)
                [[ "$value" == 0 || "$value" == 1 ]] && AUTO_LOGIN_VERBOSE="$value"
                ;;
            WINDOW_*)
                label="${key#WINDOW_}"
                read -r a b c d <<< "$value"
                [[ "$a" =~ ^-?[0-9]+$ ]] || continue
                [[ "$b" =~ ^-?[0-9]+$ ]] || continue
                [[ "$c" =~ ^[0-9]+$ ]] || continue
                [[ "$d" =~ ^[0-9]+$ ]] || continue
                WINDOW_X["$label"]="$a"
                WINDOW_Y["$label"]="$b"
                WINDOW_WIDTH["$label"]="$c"
                WINDOW_HEIGHT["$label"]="$d"
                ;;
        esac
    done < "$CFG_FILE"
}

save_config() {
    mkdir -p "$(dirname "$CFG_FILE")"

    local tmp="${CFG_FILE}.tmp.$$"
    local label

    # Один writer за раз. Любая старая версия CFG атомарно заменяется только
    # после успешного формирования временного файла.
    exec 9>"$CFG_LOCK_FILE"
    if command -v flock >/dev/null 2>&1; then
        flock -x 9
    fi

    {
        printf '# MESHKA V%s configuration\n' "$APP_VERSION"
        printf '# Один файл: режим, стиль, авто-логин и геометрия UART-окон.\n'
        printf '# Формат окна: WINDOW_ttyUSB0=X Y WIDTH HEIGHT\n\n'

        printf 'MODE=%s\n' "$MODE"
        printf 'STYLE=%s\n' "$ME_STYLE"
        printf 'AUTO_LOGIN_ENABLED=%s\n' "$AUTO_LOGIN_ENABLED"
        printf 'AUTO_LOGIN_COOLDOWN=%s\n' "$AUTO_LOGIN_COOLDOWN"
        printf 'FLASH_RETRY_ENABLED=%s\n' "$FLASH_RETRY_ENABLED"
        printf 'FLASH_RETRY_COOLDOWN=%s\n' "$FLASH_RETRY_COOLDOWN"
        printf 'FLASH_RETRY_TRIGGER=%s\n' "$FLASH_RETRY_TRIGGER"
        printf 'FLASH_RETRY_MAX=%s\n' "$FLASH_RETRY_MAX"
        printf 'POST_LOGIN_RETRY_ENABLED=%s\n' "$POST_LOGIN_RETRY_ENABLED"
        printf 'POST_LOGIN_RETRY_COOLDOWN=%s\n' "$POST_LOGIN_RETRY_COOLDOWN"
        printf 'POST_LOGIN_RETRY_TRIGGER=%s\n' "$POST_LOGIN_RETRY_TRIGGER"
        printf 'POST_LOGIN_RETRY_MAX=%s\n' "$POST_LOGIN_RETRY_MAX"
        printf 'STATE_MACHINE_ENABLED=%s\n' "$STATE_MACHINE_ENABLED"
        printf 'STATE_MACHINE_VERBOSE=%s\n' "$STATE_MACHINE_VERBOSE"
        printf 'AUTO_LOGIN_LOG_DIR=%s\n' "$AUTO_LOGIN_LOG_DIR"
        printf 'AUTO_LOGIN_VERBOSE=%s\n' "$AUTO_LOGIN_VERBOSE"

        printf '# UART WINDOWS\n'
        if ((${#WINDOW_X[@]} > 0)); then
            while IFS= read -r label; do
                [[ -n "$label" ]] || continue
                [[ -n "${WINDOW_X[$label]:-}" ]] || continue
                [[ -n "${WINDOW_Y[$label]:-}" ]] || continue
                [[ -n "${WINDOW_WIDTH[$label]:-}" ]] || continue
                [[ -n "${WINDOW_HEIGHT[$label]:-}" ]] || continue
                printf 'WINDOW_%s=%s %s %s %s\n' \
                    "$label" \
                    "${WINDOW_X[$label]}" \
                    "${WINDOW_Y[$label]}" \
                    "${WINDOW_WIDTH[$label]}" \
                    "${WINDOW_HEIGHT[$label]}"
            done < <(printf '%s\n' "${!WINDOW_X[@]}" | sort -V)
        fi
    } > "$tmp"

    mv -f "$tmp" "$CFG_FILE"

    if command -v flock >/dev/null 2>&1; then
        flock -u 9
    fi
    exec 9>&-
}


