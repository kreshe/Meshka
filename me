# ================= АНИМАЦИИ =================
anim_retro() {
    local msg="$1"
    local i
    for ((i=0; i<${#msg}; i++)); do
        printf  ${GREEN}"%c"${RESET} "${msg:$i:1}"
        sleep 0.03
    done
    echo
}

anim_icons() {
    local frames=("◐" "◓" "◑" "◒" "◐" "◓" "◑" "◒")
    local i
    for i in {1..8}; do
        printf "\rОбновление %s" "${frames[$((i%8))]}"
        sleep 0.1
    done
    echo " ✔"
}

anim_progress() {
    local msg="${1:-Прогресс}"
    printf "%-20s [" "$msg"
    local i
    for i in {1..20}; do
        printf "${CYAN}█${RESET}"
        sleep 0.03
    done
    printf "] ${GREEN}OK${RESET}\n"
}

anim_cyber() {
    local i line
    for i in {1..10}; do
        line=$(tr -dc 'A-Za-z0-9@#$%&*' </dev/urandom | head -c 60)
        echo -e "${MAGENTA}$line${RESET}"
        sleep 0.05
    done
}

