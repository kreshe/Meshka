# ================= РАСПОЛОЖЕНИЕ ОКОН =================
ensure_window_defaults() {
    local PORT LABEL

    for PORT in "${PORTS[@]}"; do
        [[ -e "$PORT" ]] || continue
        LABEL=$(basename "$PORT")

        if [[ -z "${WINDOW_X[$LABEL]:-}" ]]; then
            WINDOW_X["$LABEL"]="$WINDOW_DEFAULT_X"
            WINDOW_Y["$LABEL"]="$WINDOW_DEFAULT_Y"
            WINDOW_WIDTH["$LABEL"]="$WINDOW_DEFAULT_WIDTH"
            WINDOW_HEIGHT["$LABEL"]="$WINDOW_DEFAULT_HEIGHT"
        fi
    done
}

find_uart_window() {
    local label="$1"
    local ids candidate name wid=""

    command -v xdotool >/dev/null 2>&1 || return 1

    ids=$(xdotool search --onlyvisible --name "$label" 2>/dev/null || true)

    while read -r candidate; do
        [[ -z "$candidate" ]] && continue
        name=$(xdotool getwindowname "$candidate" 2>/dev/null || true)
        if [[ "$name" == *"$label"* ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done <<< "$ids"

    wid=$(xdotool search --name "$label" 2>/dev/null | head -n 1 || true)
    [[ -n "$wid" ]] || return 1
    printf '%s\n' "$wid"
}

read_window_geometry() {
    local wid="$1"
    xdotool getwindowgeometry --shell "$wid" 2>/dev/null || return 1
}

save_window_geometry() {
    local label="$1"
    local wid geom key value
    local x="" y="" width="" height=""

    wid=$(find_uart_window "$label" 2>/dev/null || true)
    [[ -n "$wid" ]] || return 1

    geom=$(read_window_geometry "$wid") || return 1

    while IFS='=' read -r key value; do
        case "$key" in
            X) x="$value" ;;
            Y) y="$value" ;;
            WIDTH) width="$value" ;;
            HEIGHT) height="$value" ;;
        esac
    done <<< "$geom"

    [[ "$x" =~ ^-?[0-9]+$ ]] || return 1
    [[ "$y" =~ ^-?[0-9]+$ ]] || return 1
    [[ "$width" =~ ^[0-9]+$ ]] || return 1
    [[ "$height" =~ ^[0-9]+$ ]] || return 1

    WINDOW_X["$label"]="$x"
    WINDOW_Y["$label"]="$y"
    WINDOW_WIDTH["$label"]="$width"
    WINDOW_HEIGHT["$label"]="$height"
    return 0
}

save_all_window_geometries() {
    command -v xdotool >/dev/null 2>&1 || return 0
    [[ -f "$CFG_FILE" ]] || return 0

    local PORT LABEL
    local -A CURRENT=()

    # Начинаем с последних известных координат, чтобы временно не найденное
    # окно не исчезало из CFG. Свежая геометрия ниже просто перезаписывает её.
    for LABEL in "${!WINDOW_X[@]}"; do
        [[ -n "${WINDOW_Y[$LABEL]:-}" ]] || continue
        [[ -n "${WINDOW_WIDTH[$LABEL]:-}" ]] || continue
        [[ -n "${WINDOW_HEIGHT[$LABEL]:-}" ]] || continue
        CURRENT["$LABEL"]="${WINDOW_X[$LABEL]} ${WINDOW_Y[$LABEL]} ${WINDOW_WIDTH[$LABEL]} ${WINDOW_HEIGHT[$LABEL]}"
    done

    for PORT in "${PORTS[@]}"; do
        [[ -e "$PORT" ]] || continue
        LABEL=$(basename "$PORT")

        if save_window_geometry "$LABEL"; then
            CURRENT["$LABEL"]="${WINDOW_X[$LABEL]} ${WINDOW_Y[$LABEL]} ${WINDOW_WIDTH[$LABEL]} ${WINDOW_HEIGHT[$LABEL]}"
        fi
    done

    # КРИТИЧНО: здесь больше НЕ вызываем save_config().
    # Фоновый monitor имеет собственную копию MODE/STYLE/AUTO_LOGIN и раньше
    # мог откатить изменения главного процесса. Мы меняем только строки WINDOW_.
    exec 9>"$CFG_LOCK_FILE"
    if command -v flock >/dev/null 2>&1; then
        flock -x 9
    fi

    local tmp="${CFG_FILE}.tmp.geom.$$"
    awk '!/^WINDOW_[^=]+=/ && $0 != "# UART WINDOWS"' "$CFG_FILE" > "$tmp"

    printf '\n# UART WINDOWS\n' >> "$tmp"
    if ((${#CURRENT[@]} > 0)); then
        while IFS= read -r LABEL; do
            [[ -n "$LABEL" ]] || continue
            printf 'WINDOW_%s=%s\n' "$LABEL" "${CURRENT[$LABEL]}" >> "$tmp"
        done < <(printf '%s\n' "${!CURRENT[@]}" | sort -V)
    else
        # Если окно временно не найдено, сохраняем последние известные значения.
        if ((${#WINDOW_X[@]} > 0)); then
            while IFS= read -r LABEL; do
                [[ -n "$LABEL" ]] || continue
                [[ -n "${WINDOW_Y[$LABEL]:-}" ]] || continue
                [[ -n "${WINDOW_WIDTH[$LABEL]:-}" ]] || continue
                [[ -n "${WINDOW_HEIGHT[$LABEL]:-}" ]] || continue
                printf 'WINDOW_%s=%s %s %s %s\n' \
                    "$LABEL" \
                    "${WINDOW_X[$LABEL]}" \
                    "${WINDOW_Y[$LABEL]}" \
                    "${WINDOW_WIDTH[$LABEL]}" \
                    "${WINDOW_HEIGHT[$LABEL]}" >> "$tmp"
            done < <(printf '%s\n' "${!WINDOW_X[@]}" | sort -V)
        fi
    fi

    mv -f "$tmp" "$CFG_FILE"

    flock -u 9
    exec 9>&-
}


apply_window_geometry() {
    local label="$1"
    local wid=""

    [[ -n "${WINDOW_X[$label]:-}" ]] || return 0
    [[ -n "${WINDOW_Y[$label]:-}" ]] || return 0
    [[ -n "${WINDOW_WIDTH[$label]:-}" ]] || return 0
    [[ -n "${WINDOW_HEIGHT[$label]:-}" ]] || return 0

    wid=$(find_uart_window "$label" 2>/dev/null || true)
    [[ -n "$wid" ]] || return 0

    xdotool windowsize "$wid" \
        "${WINDOW_WIDTH[$label]}" \
        "${WINDOW_HEIGHT[$label]}" 2>/dev/null || true

    xdotool windowmove "$wid" \
        "${WINDOW_X[$label]}" \
        "${WINDOW_Y[$label]}" 2>/dev/null || true
}

restore_window_geometry() {
    local label="$1"
    local wid=""
    local i

    [[ -n "${WINDOW_X[$label]:-}" ]] || return 0
    [[ -n "${WINDOW_Y[$label]:-}" ]] || return 0
    [[ -n "${WINDOW_WIDTH[$label]:-}" ]] || return 0
    [[ -n "${WINDOW_HEIGHT[$label]:-}" ]] || return 0

    for ((i=1; i<=WINDOW_GEOMETRY_RESTORE_TRIES; i++)); do
        wid=$(find_uart_window "$label" 2>/dev/null || true)
        if [[ -n "$wid" ]]; then
            xdotool windowsize "$wid" \
                "${WINDOW_WIDTH[$label]}" \
                "${WINDOW_HEIGHT[$label]}" 2>/dev/null || true
            sleep 0.15
            xdotool windowmove "$wid" \
                "${WINDOW_X[$label]}" \
                "${WINDOW_Y[$label]}" 2>/dev/null || true
            sleep 0.15
            xdotool windowsize "$wid" \
                "${WINDOW_WIDTH[$label]}" \
                "${WINDOW_HEIGHT[$label]}" 2>/dev/null || true
            xdotool windowmove "$wid" \
                "${WINDOW_X[$label]}" \
                "${WINDOW_Y[$label]}" 2>/dev/null || true
            return 0
        fi
        sleep "$WINDOW_GEOMETRY_RESTORE_DELAY"
    done
}

restore_all_window_geometries() {
    command -v xdotool >/dev/null 2>&1 || return 0

    local PORT LABEL
    for PORT in "${PORTS[@]}"; do
        [[ -e "$PORT" ]] || continue
        LABEL=$(basename "$PORT")
        restore_window_geometry "$LABEL" &
    done
}

window_geometry_monitor() {
    while true; do
        sleep "$WINDOW_GEOMETRY_INTERVAL"
        save_all_window_geometries
    done
}

start_window_geometry_monitor() {
    command -v xdotool >/dev/null 2>&1 || return 0

    stop_window_geometry_monitor
    window_geometry_monitor >/dev/null 2>&1 &
    WINDOW_GEOMETRY_MONITOR_PID="$!"
}

stop_window_geometry_monitor() {
    [[ -n "${WINDOW_GEOMETRY_MONITOR_PID:-}" ]] || return 0

    kill "$WINDOW_GEOMETRY_MONITOR_PID" 2>/dev/null || true
    wait "$WINDOW_GEOMETRY_MONITOR_PID" 2>/dev/null || true
    WINDOW_GEOMETRY_MONITOR_PID=""
}

