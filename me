auto_login() {
    echo "🔊️ Выполняется автологин. Режим: $MODE"

    local PORT
    for PORT in "${PORTS[@]}"; do
        (
            [[ -e "$PORT" ]] || exit 0
            stty -F "$PORT" "$BAUDRATE" raw -echo 2>/dev/null || true
            sleep 1
            echo "$LOGIN"    > "$PORT"
            sleep 3
            echo "$PASSWORD" > "$PORT"
            sleep 3
            if [[ "$MODE" == "flash" ]]; then
                echo "custom-installer" > "$PORT"
            elif [[ "$MODE" == "check" ]]; then
            echo "t" > "$PORT"
                sleep 1
                  echo "1" > "$PORT"
            elif [[ "$MODE" == "check_SD" ]]; then
