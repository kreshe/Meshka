reset_uart_ports() {
    echo "🔄 Перезапуск UART терминалов..."

    stop_uart_monitors
    stop_window_geometry_monitor
    save_all_window_geometries

    for PORT in "${PORTS[@]}"; do
        pkill -f "minicom -D $PORT" 2>/dev/null || true
    done

    sleep 1

    echo "🔎 Пересканирование UART..."

    sudo udevadm trigger >/dev/null 2>&1 || true
    sudo udevadm settle >/dev/null 2>&1 || true

    sleep 1

    mapfile -t PORTS < <(
        printf '%s\n' $PORT_GLOB |
        sed '/^[[:space:]]*$/d' |
        sort -V
    )

    if ((${#PORTS[@]} == 0)); then
        echo "⚠ UART устройства не найдены"
        return 0
    fi

    echo "✔ Найдено ${#PORTS[@]} UART"

    ensure_window_defaults
    save_config
    draw_ui
    open_minicom_terminals
    sleep 1
    start_uart_monitors
    start_window_geometry_monitor
}

