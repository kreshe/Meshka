# ================= UART STATE MACHINE =================
# Каждый monitor_capture_file() работает со своей платой/UART и имеет
# независимое состояние. Поэтому ошибка ttyUSB0 не меняет состояние ttyUSB1.
#
# Состояния:
#   IDLE                - ничего не выполняется
#   LOGIN_TRIGGERED     - найден login trigger
#   PASSWORD_SENT       - пароль отправлен
#   WAITING_SHELL       - ждём следующий shell/ошибку после авторизации
#   MODE_RUNNING        - выполняется действие текущего MODE
#   POST_LOGIN_RETRY    - повторяем PASSWORD -> MODE после ошибки history
#   FLASH_RETRY         - повторяем INST после flash-ошибки
#   DONE                - текущая последовательность завершена
#   ERROR               - превышен лимит попыток

uart_state_transition() {
    local label="$1"
    local state="$2"
    local reason="${3:-}"

    # Переменная UART_STATE находится в monitor_capture_file() и поэтому
    # является независимым состоянием конкретного UART.
    UART_STATE="$state"
}

uart_state_login_sequence() {
    local PORT="$1"
    local LABEL="$2"
    local AUTH_LOGIN AUTH_PASSWORD

    AUTH_LOGIN="$(get_mode_login)"
    AUTH_PASSWORD="$(get_mode_password)"

    uart_state_transition "$LABEL" "LOGIN_TRIGGERED" "login trigger"
    prepare_uart "$PORT" || return 1

    sleep 0.5
    send_uart "$PORT" "$AUTH_LOGIN" || return 1
    uart_state_transition "$LABEL" "LOGIN_SENT" "LOGIN sent"

    sleep 3
    send_uart "$PORT" "$AUTH_PASSWORD" || return 1
    uart_state_transition "$LABEL" "PASSWORD_SENT" "PASSWORD sent"

    uart_state_transition "$LABEL" "WAITING_SHELL" "waiting after authentication"
    uart_state_transition "$LABEL" "MODE_RUNNING" "$(mode_action_name)"
    run_mode_action "$PORT"
    uart_state_transition "$LABEL" "DONE" "sequence complete"
}

uart_state_post_login_retry() {
    local PORT="$1"
    local LABEL="$2"
    local attempt="$3"

    uart_state_transition "$LABEL" "POST_LOGIN_RETRY" "attempt $attempt/$POST_LOGIN_RETRY_MAX"
    retry_post_login_sequence "$PORT" || return 1
    uart_state_transition "$LABEL" "DONE" "post-login retry complete"
}

uart_state_flash_retry() {
    local PORT="$1"
    local LABEL="$2"
    local attempt="$3"

    uart_state_transition "$LABEL" "FLASH_RETRY" "attempt $attempt/$FLASH_RETRY_MAX"
    send_uart "$PORT" "$INST" || return 1
    uart_state_transition "$LABEL" "MODE_RUNNING" "custom-installer retry"
}

# ================= UART / АВТО-ЛОГИН =================
prepare_uart() {
    local port="$1"
    [[ -e "$port" ]] || return 1
    stty -F "$port" "$BAUDRATE" raw -echo 2>/dev/null || true
}

send_uart() {
    local port="$1"
    local data="$2"

    [[ -e "$port" ]] || return 1
    printf '%s\r' "$data" > "$port"
}

mode_action_name() {
    case "$MODE" in
        flash)   echo "ПРОШИВКА" ;;
        check)   echo "ТЕСТ RUN-TESTS (t → 1)" ;;
        check_SD) echo "ПРОВЕРКА SD" ;;
        RFM) echo "ПРОВЕРКА RFM" ;;
        CPU) echo "ПРОВЕРКА CPU" ;;
        *)       echo "ТОЛЬКО LOGIN/PASSWORD" ;;
    esac
}

run_mode_action() {
    local PORT="$1"

    case "$MODE" in
        flash)
            sleep 0.5
            send_uart "$PORT" "$INST"
            ;;
        check)
            sleep 0.5
            send_uart "$PORT" "t"
            sleep 1
            send_uart "$PORT" "1"
            ;;
        check_SD)
            sleep 0.5
            send_uart "$PORT" "dd if=/dev/zero of=/dev/mmcblk1 bs=1M count=2000 status=progress oflag=direct"
            ;;
        RFM)
            sleep 0.5
            send_uart "$PORT" "t"
            sleep 1
            send_uart "$PORT" "12"
            ;;
        CPU)
            sleep 0.5
            send_uart "$PORT" "p"
            ;;
        *)
            return 0
            ;;
    esac
}

# Повторная отправка ВСЕЙ последовательности после уже выполненного логина.
# Логин (LOGIN) заново НЕ отправляем: повторяем именно то, что должно идти
# после него — PASSWORD, затем действие текущего MODE.
retry_post_login_sequence() {
    local PORT="$1"
    local AUTH_PASSWORD

    AUTH_PASSWORD="$(get_mode_password)"

    [[ -e "$PORT" ]] || return 1

    prepare_uart "$PORT"

    # Для CPU используется пароль zz12zz34,
    # для остальных режимов — обычный PASSWORD.
    sleep 0.5
    send_uart "$PORT" "$AUTH_PASSWORD"
    run_mode_action "$PORT"
}

