if [[ -z "$MODE" ]]; then
    echo "=================================="
    echo "      ВЫБЕРИ РЕЖИМ (первый запуск)"
    echo "=================================="
    echo "1) Прошивать"
    echo "2) Проверять"
    echo "3) Проверка SD"
    echo "4) RFM"
    echo "5) CPU"
    echo

    while true; do
        read -rsn1 CH
        case "$CH" in
            1)
                MODE="flash"
                save_config
                break
                ;;
            2)
                MODE="check"
                save_config
                break
                ;;
            3)
                MODE="check_SD"
                save_config
                break
                ;;
            4)
                MODE="RFM"
                save_config
                break
                ;;
            5) 
                MODE="CPU"
                save_config
                break
                ;;
        esac
    done

    echo "➡️ Сохранено: $MODE"
else
    echo "💿️  Загружен режим : $MODE"
    echo "✈️   Запускаем прогрев турбин"
fi

change_mode() {
    clear
    echo "========================"
    echo "     СМЕНА РЕЖИМА"
    echo "========================"
    echo "1) Прошивать"
    echo "2) Проверять"
    echo "3) Проверка SD"
    echo "4) RFM"
    echo "5) CPU"
    echo "0) Отмена"
    echo

    read -rsn1 CH

    case "$CH" in
        1)
            MODE="flash"
            echo "✔ режим: Прошивка"
            ;;
        2)
            MODE="check"
            echo "✔ режим: Проверка"
            ;;
        3)
            MODE="check_SD"
            echo "✔ режим: Проверка_SD"
            ;;
        4)
            MODE="RFM"
            echo "✔ режим: RFM"
            ;;
        5)
            MODE="CPU"
            echo "✔ режим: CPU"
            ;;
        *)
            echo "отмена"
            ;;
    esac

    save_config

    if [[ "$AUTO_LOGIN_ENABLED" == "1" ]]; then
        stop_uart_monitors
        start_uart_monitors
    fi

    draw_ui
}

