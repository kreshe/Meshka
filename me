# ================= ОТКРЫТИЕ MINICOM =================
open_minicom_terminals() {
    local term_type=""

    if command -v gnome-terminal >/dev/null 2>&1; then
        term_type="gnome"
    elif command -v konsole >/dev/null 2>&1; then
        term_type="konsole"
    elif command -v xfce4-terminal >/dev/null 2>&1; then
        term_type="xfce"
    elif command -v xterm >/dev/null 2>&1; then
        term_type="xterm"
    else
        echo "❌ Терминал не найден"
        return 1
    fi

    if ((${#PORTS[@]} == 0)); then
        echo "⚠ Порты ${PORT_GLOB} не найдены."
        return 0
    fi

    mkdir -p "$AUTO_LOGIN_LOG_DIR"
    ensure_window_defaults

    # Сохраняем cfg сразу после создания defaults.
    save_config

    local PORT LABEL STATUS LOGFILE PORT_Q BAUD_Q LOG_Q

    for PORT in "${PORTS[@]}"; do
        [[ -e "$PORT" ]] || continue

        LABEL=$(basename "$PORT")
        STATUS=$(get_port_status "$PORT")

        if [[ "$STATUS" == BUSY:* ]]; then
            echo "⚠ $LABEL занят (${STATUS#BUSY:}) — окно не открывается"
            continue
        fi

        if [[ "$STATUS" == MINICOM ]]; then
            echo "⚠ $LABEL уже открыт в minicom — окно не открывается"
            continue
        fi

        if [[ ! -r "$PORT" || ! -w "$PORT" ]]; then
            echo "⚠ $LABEL — нет прав доступа — окно не открывается"
            continue
        fi

        LOGFILE="$AUTO_LOGIN_LOG_DIR/${LABEL}.log"
        : > "$LOGFILE"

        printf -v PORT_Q '%q' "$PORT"
        printf -v BAUD_Q '%q' "$BAUDRATE"
        printf -v LOG_Q '%q' "$LOGFILE"

        if [[ "$term_type" == "gnome" ]] && ! command -v dbus-launch >/dev/null 2>&1; then
            install_dbus_x11 || {
                echo "⚠ $LABEL — dbus недоступен — окно не открывается"
                continue
            }
        fi

        echo "😘️ Открываю minicom для $LABEL"

        case "$term_type" in
            gnome)
                gnome-terminal \
                    --geometry=66x20 \
                    --title="$LABEL" \
                    -- bash -c "
                        echo 'minicom → $PORT';
                        echo 'capture → $LOGFILE';
                        echo;
                        TERM=xterm-256color minicom -D $PORT_Q -b $BAUD_Q -c on -a on -C $LOG_Q;
                        RC=\$?;
                        if [[ \$RC -ne 0 ]]; then
                            echo;
                            echo '========================================';
                            echo '❌ Не удалось открыть UART: $PORT';
                            echo \"❌ minicom завершился с кодом: \$RC\";
                            echo '========================================';
                            echo;
                            echo 'Окно оставлено открытым для диагностики.';
                            echo 'Нажмите ENTER для закрытия.';
                            read -r;
                        fi
                        exit \$RC
                    " &
                ;;
            konsole)
                konsole \
                    --geometry 80x24 \
