# ================= СТАТУС ПОРТОВ =================
get_port_status() {
    local port="$1"
    local info

    info=$(lsof "$port" 2>/dev/null | awk 'NR==2{print $1}')

    if [[ -z "$info" ]]; then
        echo "FREE"
    elif [[ "$info" == "minicom" ]]; then
        echo "MINICOM"
    else
        echo "BUSY:$info"
    fi
}

status_icon() {
    local status="$1"
    case "$status" in
        FREE)      echo -e "${CYAN}⚪${RESET}" ;;
        MINICOM)   echo -e "${GREEN}🟢${RESET}" ;;
        BUSY:*)    echo -e "${RED}🔴${RESET}" ;;
        *)         echo -e "${YELLOW}❓${RESET}" ;;
    esac
}

animate_status_change() {
    local port="$1"
    local old_status="$2"
    local new_status="$3"

    [[ "$old_status" == "$new_status" ]] && return

    echo -e "${YELLOW}Статус порта ${port}: ${old_status} → ${new_status}${RESET}"
}

draw_ports_status() {
    echo "┌──────────┬───────────┬────────────┐"
    echo "│ Порт     │ Статус    │ Владелец   │"
    echo "├──────────┼───────────┼────────────┤"

    local PORT LABEL STATUS ICON OWNER STATUS_TXT OLD
    for PORT in "${PORTS[@]}"; do
        [[ -e "$PORT" ]] || continue

        LABEL=$(basename "$PORT")
        STATUS=$(get_port_status "$PORT")
        ICON=$(status_icon "$STATUS")

        OLD="${PORT_OLD_STATUS[$PORT]:-}"
        if [[ -n "$OLD" ]]; then
            animate_status_change "$LABEL" "$OLD" "$STATUS"
        fi
        PORT_OLD_STATUS["$PORT"]="$STATUS"

        case "$STATUS" in
            BUSY:*)
                OWNER="${STATUS#BUSY:}"
                STATUS_TXT="ЗАНЯТ"
                ;;
            MINICOM)
                OWNER="minicom"
                STATUS_TXT="ОТКРЫТ"
                ;;
            FREE)
                OWNER="—"
                STATUS_TXT="СВОБОДЕН"
                ;;
            *)
                OWNER="?"
                STATUS_TXT="$STATUS"
                ;;
        esac

        printf "│ %-8s │ %b %-7s │ %-10s │\n" \
            "$LABEL" "$ICON" "$STATUS_TXT" "$OWNER"
    done

    echo "└──────────┴───────────┴────────────┘"
}

# ================= ОТРИСОВКА UI =================
draw_ui() {
    
    case "$ME_STYLE" in
        retro)
            ui_retro
