dependencies=(stty tr head minicom lsof tail xdotool flock sort sed)

install_pkg() {
    local pkg="$1"
    local apt_pkg="$pkg"

    if command -v "$pkg" >/dev/null 2>&1; then
        return 0
    fi

    case "$pkg" in
        flock)
            apt_pkg="util-linux"
            ;;
        stty|tr|head|tail)
            apt_pkg="coreutils"
            ;;
    esac

    echo "Пакет/команда $pkg не найден(а). Пытаемся установить $apt_pkg..."

    if command -v apt >/dev/null 2>&1; then
        sudo apt update >/dev/null 2>&1 || true
        sudo apt install -y "$apt_pkg"
    else
        echo "Менеджер пакетов не найден. Установите $pkg вручную."
        return 1
    fi
}

for dep in "${dependencies[@]}"; do
    install_pkg "$dep" || echo "⚠ Не удалось установить $dep, некоторые функции могут не работать."
done

install_dbus_x11() {
    if command -v dbus-launch >/dev/null 2>&1; then
        return 0
    fi

    echo "⚠ dbus-launch не найден, устанавливаю dbus-x11..."

    if command -v apt >/dev/null 2>&1; then
        sudo apt update >/dev/null 2>&1 || true
        sudo apt install -y dbus-x11
    else
        echo "❌ Не удалось установить dbus-x11 автоматически"
        return 1
    fi
}

