# ================= dbus-x11 (для gnome-terminal) =================
install_dbus_x11() {
    if command -v dbus-launch >/dev/null 2>&1; then
        return 0
    fi

    echo "⚠ dbus-launch не найден, устанавливаю dbus-x11..."

    if command -v apt >/dev/null 2>&1; then
        sudo apt update
        sudo apt install -y dbus-x11
    else
        echo "❌ Не удалось установить dbus-x11 автоматически"
        return 1
    fi
}

# ================= ОТКРЫТИЕ MINICOM =================
open_minicom_terminals() {
    local term_type=""

    if command -v gnome-terminal >/dev/null 2>&1; then
        term_type="gnome"
    elif command -v konsole >/dev/null 2>&1; then
        term_type="konsole"
    elif command -v xfce4-terminal >/dev/null 2>&1; then
        term_type="xfce"
    elif command -v xterm >/dev/null 2>&1; then
        term_type="xterm"
    else
        echo "❌ Терминал не найден"
        return 1
    fi

    # если нет портов — просто сообщаем
    if ((${#PORTS[@]} == 0)); then
        echo "⚠ Порты ${PORT_GLOB} не найдены."
        return 0
    fi

    local PORT LABEL STATUS

    for PORT in "${PORTS[@]}"; do
        [[ -e "$PORT" ]] || continue

        LABEL=$(basename "$PORT")
        STATUS=$(get_port_status "$PORT")

        if [[ "$STATUS" == BUSY:* ]]; then
            echo "⚠ $LABEL занят (${STATUS#BUSY:})"
            continue
        fi

        if [[ ! -r "$PORT" || ! -w "$PORT" ]]; then
            echo "⚠ $LABEL — нет прав доступа"
            continue
        fi

        if [[ "$term_type" == "gnome" ]] && ! command -v dbus-launch >/dev/null 2>&1; then
            echo "⚠ $LABEL — dbus недоступен"
            continue
        fi

        echo "😘️ Открываю minicom для $LABEL"

        case "$term_type" in
            gnome)
                gnome-terminal \
                    --geometry=70x24 \
                    --title="$LABEL" \
                    -- bash -c "
                        echo 'minicom → $PORT';
                        exec minicom -D '$PORT' -b '$BAUDRATE'
                    " &
                ;;
            konsole)
                konsole \
                    --geometry 70x24 \
                    --new-tab \
                    -p tabtitle="$LABEL" \
                    -e bash -c "
                        echo 'minicom → $PORT';
                        exec minicom -D '$PORT' -b '$BAUDRATE'
                    " &
                ;;
            xfce)
                xfce4-terminal \
                    --geometry=70x24 \
                    --title="$LABEL" \
                    -e bash -c "
                        echo 'minicom → $PORT';
                        exec minicom -D '$PORT' -b '$BAUDRATE'
                    " &
                ;;
            xterm)
                xterm \
                    -geometry 70x24 \
                    -T "$LABEL" \
                    -e bash -c "
                        echo 'minicom → $PORT';
                        exec minicom -D '$PORT' -b '$BAUDRATE'
                    " &
                ;;
        esac

        sleep 0.2
    done

    echo "⌨️  Вводите: "
}

