reset_uart_ports() {

    echo "🔄 Перезапуск UART терминалов..."

    # закрываем только наши minicom
    for PORT in "${PORTS[@]}"; do
        pkill -f "minicom -D $PORT" 2>/dev/null || true
    done

    sleep 1

    echo "🔎 Пересканирование UART..."

    # пересканировать устройства
    sudo udevadm trigger >/dev/null 2>&1 || true
    sudo udevadm settle >/dev/null 2>&1 || true

    sleep 1

    # обновить список портов
    PORTS=($PORT_GLOB)

    if ((${#PORTS[@]} == 0)); then
        echo "⚠ UART устройства не найдены"
        return
    fi

    echo "✔ Найдено ${#PORTS[@]} UART"

    draw_ui
    open_minicom_terminals
}

